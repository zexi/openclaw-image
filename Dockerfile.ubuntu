ARG BASE_IMAGE=registry.cn-beijing.aliyuncs.com/zexi/openclaw-base:ubu-v2026.3.2-20260303.0

FROM ${BASE_IMAGE}

# Remove default nginx site
# RUN rm -f /etc/nginx/sites-enabled/default

COPY scripts/ /app/scripts/
RUN chmod +x /app/scripts/*.sh

# 使用 npm 安装 @sliverp/qqbot 插件到 /opt/extensions/qqbot
RUN mkdir -p /opt/extensions \
  && cd /opt/extensions \
  && npm init -y \
  && npm install @sliverp/qqbot@1.5.4 \
  && mv node_modules/@sliverp/qqbot qqbot \
  && rm -rf node_modules package.json package-lock.json

# 安装基于 s6-rc 的 openclaw GUI 服务定义和 XFCE 自动打开浏览器脚本
COPY root/ /
RUN chmod +x /etc/s6-overlay/s6-rc.d/svc-openclaw-gui/run \
  && chmod +x /usr/local/bin/openclaw-open-browser.sh || true

# 把 linuxbrew 移动到 /opt 目录下，启动脚本再把这个移动回来，解决 volume 挂载后 linuxbrew 目录被覆盖的问题
RUN mv /home/linuxbrew /opt

# 安装插件
RUN npm install -g clawhub && apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  	poppler-utils \
	pandoc \
  && rm -rf /var/lib/apt/lists/*

# 需要在桌面启动的时候调用这个脚本
# ENTRYPOINT ["/app/scripts/entrypoint.sh"] 
